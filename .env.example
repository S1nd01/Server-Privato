# Non serve copiare né modificare a mano questo file: ./src/scripts/sync-env.sh (o start.sh, o setup-windows.bat)
# crea il .env e salva tutti i dati nella directory data/ del progetto.
TZ=Europe/Rome
PUID=1000
PGID=1000

# ---------- Percorsi (impostati automaticamente in data/ dal progetto; non modificarli) ----------
# DATA_DIR e le cartelle sottostanti devono stare su filesystem Linux (ext4): Postgres e SQLite non vanno su exFAT/NTFS.
DATA_DIR=

# ---------- Rete ----------
# Indirizzo su cui il computer pubblica le porte dei servizi.
# 127.0.0.1 = solo dal computer stesso (consigliato: dal telefono si passa da Tailscale).
# 0.0.0.0   = anche dalla rete di casa (es. per la TV con Jellyfin); servono le regole del firewall.
BIND_ADDR=127.0.0.1

# ---------- Pannello ----------
# Se impostato, ogni chiamata API richiede il token (il pannello lo chiede al primo accesso).
# Non scriverlo a mano: ./src/scripts/gen-api-token.sh lo genera, mostra il token una volta e salva qui solo l'hash.
API_TOKEN_HASH=
# Vecchio metodo (token in chiaro): lasciare vuoto
API_TOKEN=

# ---------- Tailscale (accesso da fuori casa, in HTTPS) ----------
# Nome del server nella tua rete Tailscale: l'indirizzo sara' https://<nome>.<tuarete>.ts.net
TS_HOSTNAME=homeserver
# Chiave di autenticazione: login.tailscale.com -> Settings -> Keys -> Generate auth key.
# Serve solo al primo avvio; dopo puoi toglierla. Vuota = accedi dal link che compare nel pannello (Rete).
TS_AUTHKEY=

# ---------- Immich ----------
# Solo lettere e numeri, scegli PRIMA del primo avvio (cambiarla dopo richiede di rifare il database)
IMMICH_DB_PASSWORD=cambiami
IMMICH_VERSION=release
# Cartella foto dentro data/: Immich la legge in sola lettura come libreria esterna (/mnt/photos).
PHOTOS_DIR=

# ---------- Jellyfin ----------
# Cartella media dentro data/ (la imposta lo script): Film, Serie TV, Discoveries e downloads.
# Jellyfin la legge in sola lettura (tranne Discoveries); Radarr, Sonarr e qBittorrent ci scrivono (docs/seerr.md).
MEDIA_DIR=

# ---------- ntfy (notifiche push) ----------
# Indirizzo con cui l'app sul telefono raggiunge ntfy, come lo vedi nel pannello (sezione Rete): https://homeserver.tuarete.ts.net:2586
# Vuoto = http://localhost:2586 (solo dal server)
NTFY_BASE_URL=

# ---------- Utility (docs/manutenzione.md, docs/compressione.md) ----------
# Diun (avvisi di aggiornamento) scrive su ntfy, che e' in deny-all: serve un utente con permesso di scrittura.
# Come crearlo: docs/manutenzione.md. Vuoti = Diun controlla ma le notifiche non arrivano.
DIUN_NTFY_USER=
DIUN_NTFY_PASSWORD=
# Argomento ntfy delle notifiche e orario del controllo (cron a 5 campi, tra virgolette: il .env viene letto anche da script di shell). Facoltativi
DIUN_NTFY_TOPIC=homeserver
DIUN_SCHEDULE="0 8 * * *"
# Unmanic (compressione video): tetto di CPU in core e di RAM. Facoltativi
UNMANIC_CPUS=2
UNMANIC_MEM=2g

# ---------- Pi-hole ----------
# Password dell'interfaccia web: la genera ./src/scripts/sync-env.sh se e' vuota
PIHOLE_PASSWORD=
# Dove ascolta il DNS. 127.0.0.1 = solo test dal computer. Per tutta la rete: l'IP del server (docs/pihole.md)
PIHOLE_DNS_BIND=192.168.178.36
PIHOLE_WEB_BIND=0.0.0.0

# ---------- Vaultwarden (HTTPS da Tailscale, porta 8443) ----------
# Indirizzo con cui lo raggiungi da Tailscale, esattamente come lo vedi nel pannello (sezione Rete):
# https://homeserver.tuarete.ts.net:8443
# Vuoto = http://localhost:8222 (solo dal server stesso, per emergenza)
VW_DOMAIN=
# true solo per creare il TUO account, poi false e `docker compose up -d vaultwarden`
VW_SIGNUPS=true
# Pannello /admin: vuoto = disattivato. Generalo con: docker run --rm -it vaultwarden/server /vaultwarden hash
# Incolla l'hash tra APICI SINGOLI (contiene i simboli $): ADMIN_TOKEN='$argon2id$v=19$...'
ADMIN_TOKEN=

# ---------- Backup (cartelle fisse dentro data/backups) ----------
# done = backup impostati
BACKUP_SETUP=
# Cartella dei backup cifrati di Vaultwarden (script backup-vaultwarden.sh).
BACKUP_DIR=
# File con la passphrase (permessi 600, minimo 20 caratteri). Lo script la genera in ~/.vw-backup-pass.
# Copiala anche FUORI dal server: senza, i backup non si aprono.
BACKUP_PASSPHRASE_FILE=

# ---------- Backup con Restic (docs/restic.md) ----------
# Cartella fissa dell'archivio Restic dentro data/backups.
RESTIC_REPO_DIR=
# File con la passphrase dell'archivio (lo script la genera in ~/.restic-pass): senza non si ripristina nulla,
# copiala anche FUORI dal server.
RESTIC_PASSWORD_FILE=
# Backup automatico ogni giorno a quest'ora (HH:MM). Vuoto = solo manuale
RESTIC_SCHEDULE=03:30
# Disco esterno per l'archivio Restic (lo imposta ./src/scripts/backup-disco.sh; vuoto = archivio locale in data/backups).
BACKUP_DISK_DIR=
# Cartella che CONTIENE il disco (per esempio /media/utente): il backend la monta in sola lettura per vedere il disco anche
# se lo colleghi dopo l'avvio. Vuoto = data/backups.
BACKUP_MOUNT_PARENT=
# Il pannello avvisa quando l'ultima copia ha piu' di questi giorni (14 di default, 0 = mai).
BACKUP_WARN_DAYS=14

# ---------- Recyclarr, Beszel, Tailscale (aggiunte) ----------
# Recyclarr: quando sincronizza (cron a 5 campi tra virgolette, oppure @daily, @hourly...). Docs: docs/recyclarr.md
RECYCLARR_SCHEDULE=@daily
# Chiavi API di Radarr e Sonarr per Recyclarr: le scrive ./src/scripts/post-avvio.sh leggendole dalla loro configurazione
RADARR_API_KEY=
SONARR_API_KEY=
# Beszel (docs/beszel.md): chiave pubblica del hub per l'agente (la scrive post-avvio.sh) e indirizzo .ts.net del hub (facoltativo)
BESZEL_KEY=
BESZEL_APP_URL=
# Tailscale: IP del server da pubblicare per usare Pi-hole fuori casa (docs/setup-pihole.md), per esempio 192.168.178.36/32. Vuoto = nessuna
TS_ROUTES=

# ---------- Scambio file, Syncthing, convertitore (docs/scambio-file.md, docs/syncthing.md, docs/convertx.md) ----------
# Copyparty: su quale indirizzo ascolta. 127.0.0.1 = solo dal server (da fuori casa: Tailscale, HTTPS). Per usarlo dalla rete di casa
# metti l'IP del server (o 0.0.0.0): in LAN e' HTTP, quindi password e file passano in chiaro. Lo account lo crea ./src/scripts/copyparty-setup.sh
COPYPARTY_BIND_ADDR=127.0.0.1
COPYPARTY_MEM=512m
SYNCTHING_MEM=512m
# ConvertX (profilo "convertx", di solito spento): tetti di CPU e RAM e dopo quante ore si cancellano i file caricati
CONVERTX_CPUS=2
CONVERTX_MEM=1g
CONVERTX_DELETE_HOURS=24

# ---------- Plex (profilo "plex", di solito spento: docs/plex.md) ----------
# Token per associare il server al tuo account plex.tv: vale pochi minuti, si ottiene su https://plex.tv/claim e serve solo al primo avvio
PLEX_CLAIM=
# Dove ascolta la porta 32400: 127.0.0.1 = solo dal server (da fuori casa: Tailscale, HTTPS). Per la TV di casa metti l'IP del server
PLEX_BIND_ADDR=127.0.0.1
# Indirizzo Tailscale pubblicato ai client Plex, per esempio https://homeserver.tuarete.ts.net:32400 (vuoto = lo imposti dall'interfaccia)
PLEX_ADVERTISE_IP=
PLEX_CPUS=3
PLEX_MEM=2g

# ---------- RomM (profilo "romm", di solito spento: docs/romm.md) ----------
# Password del database e chiave di sessione: le genera ./src/scripts/sync-env.sh (non cambiare ROMM_DB_PASSWORD dopo la prima creazione)
ROMM_DB_PASSWORD=
ROMM_DB_ROOT_PASSWORD=
ROMM_AUTH_SECRET_KEY=
# Fornitori di metadati, tutti facoltativi (account gratuiti). Vuoti = niente copertine e descrizioni, la scansione funziona lo stesso
ROMM_IGDB_CLIENT_ID=
ROMM_IGDB_CLIENT_SECRET=
ROMM_SCREENSCRAPER_USER=
ROMM_SCREENSCRAPER_PASSWORD=
ROMM_RETROACHIEVEMENTS_API_KEY=
ROMM_STEAMGRIDDB_API_KEY=
ROMM_HASHEOUS=true
ROMM_CPUS=2
ROMM_MEM=1g
ROMM_DB_MEM=512m

# ---------- Backup fuori sede con rclone (docs/backup-remoto.md) ----------
# Destinazione come la chiama rclone: <nome del remote>:<cartella>, per esempio b2:miobucket/homeserver-restic. Si crea con
# ./src/scripts/backup-remoto.sh --config. Vuoto = nessuna copia fuori sede.
RCLONE_REMOTE=
# Massimo di file che una copia puo' cancellare sul remoto: se il locale e' stato svuotato per errore la copia si ferma qui.
# La pulizia di Restic (forget --prune) puo' cancellarne molti: se serve alzalo.
BACKUP_REMOTO_MAX_DELETE=2000
# Facoltativo: indirizzo "push" di un monitor di Uptime Kuma (tipo Push): se la copia non riesce per piu' giorni Kuma ti avvisa.
BACKUP_REMOTO_KUMA_PUSH=

# ---------- Controllo dei dischi (SMART) (docs/smart.md) ----------
# Dischi da controllare, separati da spazio (per esempio "/dev/sda /dev/nvme0"). Vuoto = tutti quelli che trova smartctl --scan.
SMART_DEVICES=
# Temperatura oltre la quale avvisa (gradi)
SMART_TEMP_WARN=55
# Argomento ntfy degli avvisi (con gli stessi utente e password di Diun: DIUN_NTFY_USER / DIUN_NTFY_PASSWORD)
SMART_NTFY_TOPIC=homeserver

# ---------- VPN per qBittorrent (docs/vpn.md) ----------
# Si imposta con ./src/scripts/vpn-setup.sh, che scrive anche COMPOSE_FILE (NON metterlo qui): non modificare a mano se non sai cosa fai.
# Senza questi valori la VPN e' spenta e qBittorrent esce con la tua connessione.
WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
# File con la chiave privata WireGuard (permessi 600, FUORI da data/ e dal progetto, per esempio ~/.wireguard-key)
WIREGUARD_KEY_FILE=
