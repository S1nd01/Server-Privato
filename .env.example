# Copia in .env e modifica. Se hai già un .env di una versione precedente: ./scripts/sync-env.sh
TZ=Europe/Rome
PUID=1000
PGID=1000

# ---------- Percorsi (DEVONO essere ASSOLUTI: il backend li passa al demone Docker) ----------
# Dati dei servizi (database, config). Filesystem Linux (ext4): Postgres e SQLite non vanno su exFAT/NTFS.
DATA_DIR=/home/CAMBIAMI/homeserver-data
# Dove SteamCMD scarica i giochi. Puo' essere l'SSD formattato exFAT/NTFS per usarlo poi su Windows.
STEAM_GAMES_DIR=/home/CAMBIAMI/homeserver-data/steam-games

# ---------- Rete ----------
# Indirizzo su cui il computer pubblica le porte dei servizi.
# 127.0.0.1 = solo dal computer stesso (consigliato: dal telefono si passa da Tailscale).
# 0.0.0.0   = anche dalla rete di casa (es. per la TV con Jellyfin); servono le regole del firewall.
BIND_ADDR=127.0.0.1

# ---------- Pannello ----------
# Se impostato, ogni chiamata API richiede il token (il pannello lo chiede al primo accesso).
# Non scriverlo a mano: ./scripts/gen-api-token.sh lo genera, mostra il token una volta e salva qui solo l'hash.
API_TOKEN_HASH=
# Vecchio metodo (token in chiaro): lasciare vuoto
API_TOKEN=

# ---------- Tailscale (accesso da fuori casa, in HTTPS) ----------
# Nome del server nella tua rete Tailscale: l'indirizzo sara' https://<nome>.<tuarete>.ts.net
TS_HOSTNAME=homeserver
# Chiave di autenticazione: login.tailscale.com -> Settings -> Keys -> Generate auth key.
# Serve solo al primo avvio; dopo puoi toglierla. Vuota = accedi dal link che compare nel pannello (Rete).
TS_AUTHKEY=

# ---------- Immich ----------
# Solo lettere e numeri, scegli PRIMA del primo avvio (cambiarla dopo richiede di rifare il database)
IMMICH_DB_PASSWORD=cambiami
IMMICH_VERSION=release
# Cartella con le tue foto esistenti: Immich la legge in sola lettura come libreria esterna (/mnt/photos).
# Vuoto = $DATA_DIR/photos. Esempio per un SSD montato: /mnt/e/Foto
# Se lo imposti, anche il backup Restic salva questa cartella.
PHOTOS_DIR=

# ---------- Jellyfin ----------
# Cartella con film, serie e musica (sola lettura). Vuoto = $DATA_DIR/media
MEDIA_DIR=

# ---------- Pi-hole ----------
# Password dell'interfaccia web: la genera ./scripts/sync-env.sh se e' vuota
PIHOLE_PASSWORD=
# Dove ascolta il DNS. 127.0.0.1 = solo test dal computer. Per tutta la rete: l'IP del server (docs/pihole.md)
PIHOLE_DNS_BIND=127.0.0.1

# ---------- Vaultwarden (dietro Caddy, HTTPS) ----------
# Nome con cui raggiungi il server dai tuoi dispositivi (localhost, IP LAN, nome host, dominio)
VW_HOST=localhost
VW_PORT=8443
# Indirizzo pubblico completo, se lo usi da Tailscale: https://homeserver.tuarete.ts.net:8443
# Vuoto = https://<VW_HOST>:<VW_PORT>
VW_DOMAIN=
# true solo per creare il TUO account, poi false e `docker compose up -d vaultwarden`
VW_SIGNUPS=true
# Pannello /admin: vuoto = disattivato. Generalo con: docker run --rm -it vaultwarden/server /vaultwarden hash
# Incolla l'hash tra APICI SINGOLI (contiene i simboli $): ADMIN_TOKEN='$argon2id$v=19$...'
ADMIN_TOKEN=

# ---------- Backup di Vaultwarden con script (gpg, AES-256) ----------
# File con la passphrase, permessi 600, minimo 20 caratteri.
# Crealo con: umask 077; openssl rand -base64 32 > ~/.vw-backup-pass
BACKUP_PASSPHRASE_FILE=

# ---------- Backup con Restic (docs/restic.md) ----------
# Cartella dell'archivio, meglio su un altro disco (es. /mnt/e/backup-restic). Vuoto = backup disattivato
RESTIC_REPO_DIR=
# File con la passphrase dell'archivio: senza non si ripristina nulla, copiala anche FUORI dal server.
# Crealo con: umask 077; openssl rand -base64 32 > ~/.restic-pass
RESTIC_PASSWORD_FILE=
# Backup automatico ogni giorno a quest'ora (HH:MM). Vuoto = solo manuale
RESTIC_SCHEDULE=03:30

# ---------- SteamCMD ----------
STEAMCMD_IMAGE=steamcmd/steamcmd:latest
