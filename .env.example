# Copia in .env e modifica
TZ=Europe/Rome

# Dove salvare i dati. Su PC una cartella locale; sul Raspberry il mount dell'SSD (es. /mnt/ssd)
DATA_DIR=./data

# Immich
IMMICH_DB_PASSWORD=cambiami
IMMICH_VERSION=release

# WireGuard
WG_HOST=tuo-dominio-o-ip-pubblico
WG_PEERS=2

# Steam (linuxserver/steam)
PUID=1000
PGID=1000
