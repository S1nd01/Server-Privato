# Non serve copiare né modificare a mano questo file: ./src/scripts/sync-env.sh (o start.sh, o setup-windows.bat)
# crea il .env e salva tutti i dati nella directory data/ del progetto.
TZ=Europe/Rome
PUID=1000
PGID=1000

# ---------- Percorsi (impostati automaticamente in data/ dal progetto; non modificarli) ----------
# DATA_DIR e le cartelle sottostanti devono stare su filesystem Linux (ext4): Postgres e SQLite non vanno su exFAT/NTFS.
DATA_DIR=
STEAM_GAMES_DIR=

# ---------- Rete ----------
# Indirizzo su cui il computer pubblica le porte dei servizi.
# 127.0.0.1 = solo dal computer stesso (consigliato: dal telefono si passa da Tailscale).
# 0.0.0.0   = anche dalla rete di casa (es. per la TV con Jellyfin); servono le regole del firewall.
BIND_ADDR=127.0.0.1

# ---------- Pannello ----------
# Se impostato, ogni chiamata API richiede il token (il pannello lo chiede al primo accesso).
# Non scriverlo a mano: ./src/scripts/gen-api-token.sh lo genera, mostra il token una volta e salva qui solo l'hash.
API_TOKEN_HASH=
# Vecchio metodo (token in chiaro): lasciare vuoto
API_TOKEN=

# ---------- Tailscale (accesso da fuori casa, in HTTPS) ----------
# Nome del server nella tua rete Tailscale: l'indirizzo sara' https://<nome>.<tuarete>.ts.net
TS_HOSTNAME=homeserver
# Chiave di autenticazione: login.tailscale.com -> Settings -> Keys -> Generate auth key.
# Serve solo al primo avvio; dopo puoi toglierla. Vuota = accedi dal link che compare nel pannello (Rete).
TS_AUTHKEY=

# ---------- Immich ----------
# Solo lettere e numeri, scegli PRIMA del primo avvio (cambiarla dopo richiede di rifare il database)
IMMICH_DB_PASSWORD=cambiami
IMMICH_VERSION=release
# Cartella foto dentro data/: Immich la legge in sola lettura come libreria esterna (/mnt/photos).
PHOTOS_DIR=

# ---------- Jellyfin ----------
# Cartella media dentro data/ (la imposta lo script): Film, Serie TV, Discoveries e downloads.
# Jellyfin la legge in sola lettura (tranne Discoveries); Radarr, Sonarr e qBittorrent ci scrivono (docs/seerr.md).
MEDIA_DIR=

# ---------- Pi-hole ----------
# Password dell'interfaccia web: la genera ./src/scripts/sync-env.sh se e' vuota
PIHOLE_PASSWORD=
# Dove ascolta il DNS. 127.0.0.1 = solo test dal computer. Per tutta la rete: l'IP del server (docs/pihole.md)
PIHOLE_DNS_BIND=192.168.178.36
PIHOLE_WEB_BIND=0.0.0.0

# ---------- Vaultwarden (dietro Caddy, HTTPS) ----------
# Nome con cui raggiungi il server dai tuoi dispositivi (localhost, IP LAN, nome host, dominio)
VW_HOST=localhost
VW_PORT=8443
# Indirizzo pubblico completo, se lo usi da Tailscale: https://homeserver.tuarete.ts.net:8443
# Vuoto = https://<VW_HOST>:<VW_PORT>
VW_DOMAIN=
# true solo per creare il TUO account, poi false e `docker compose up -d vaultwarden`
VW_SIGNUPS=true
# Pannello /admin: vuoto = disattivato. Generalo con: docker run --rm -it vaultwarden/server /vaultwarden hash
# Incolla l'hash tra APICI SINGOLI (contiene i simboli $): ADMIN_TOKEN='$argon2id$v=19$...'
ADMIN_TOKEN=

# ---------- Backup (cartelle fisse dentro data/backups) ----------
# done = backup impostati
BACKUP_SETUP=
# Cartella dei backup cifrati di Vaultwarden (script backup-vaultwarden.sh).
BACKUP_DIR=
# File con la passphrase (permessi 600, minimo 20 caratteri). Lo script la genera in ~/.vw-backup-pass.
# Copiala anche FUORI dal server: senza, i backup non si aprono.
BACKUP_PASSPHRASE_FILE=

# ---------- Backup con Restic (docs/restic.md) ----------
# Cartella fissa dell'archivio Restic dentro data/backups.
RESTIC_REPO_DIR=
# File con la passphrase dell'archivio (lo script la genera in ~/.restic-pass): senza non si ripristina nulla,
# copiala anche FUORI dal server.
RESTIC_PASSWORD_FILE=
# Backup automatico ogni giorno a quest'ora (HH:MM). Vuoto = solo manuale
RESTIC_SCHEDULE=03:30

# ---------- SteamCMD ----------
STEAMCMD_IMAGE=steamcmd/steamcmd:latest