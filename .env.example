# Copia in .env e modifica
TZ=Europe/Rome
PUID=1000
PGID=1000

# ---------- Percorsi (DEVONO essere ASSOLUTI: il backend li passa al demone Docker) ----------
# Dati dei servizi (database, config). Filesystem Linux (ext4): Postgres e SQLite non vanno su exFAT/NTFS.
DATA_DIR=/home/CAMBIAMI/homeserver-data
# Dove SteamCMD scarica i giochi. Puo' essere l'SSD formattato exFAT/NTFS per usarlo poi su Windows.
STEAM_GAMES_DIR=/home/CAMBIAMI/homeserver-data/steam-games

# ---------- Pannello ----------
# Se non vuoto, ogni chiamata API richiede questo token (il pannello lo chiede al primo accesso).
API_TOKEN=

# ---------- Immich ----------
# Solo lettere e numeri, scegli PRIMA del primo avvio (cambiarla dopo richiede di rifare il database)
IMMICH_DB_PASSWORD=cambiami
IMMICH_VERSION=release
# Cartella con le tue foto esistenti: Immich la legge in sola lettura come libreria esterna (/mnt/photos).
# Vuoto = $DATA_DIR/photos. Esempio per un SSD montato: /mnt/e/Foto
PHOTOS_DIR=

# ---------- Vaultwarden (dietro Caddy, HTTPS) ----------
# Nome con cui raggiungi il server dai tuoi dispositivi (localhost, IP LAN, nome host, dominio)
VW_HOST=localhost
VW_PORT=8443
# true solo per creare il TUO account, poi false e `docker compose up -d vaultwarden`
VW_SIGNUPS=true
# Pannello /admin: vuoto = disattivato. Generalo con: docker run --rm -it vaultwarden/server /vaultwarden hash
# Incolla l'hash tra APICI SINGOLI (contiene i simboli $): ADMIN_TOKEN='$argon2id$v=19$...'
ADMIN_TOKEN=

# ---------- WireGuard ----------
# IP pubblico o DDNS di casa (inutile finche' non apri la porta sul router)
WG_HOST=tuo-dominio-ddns.example
# Nomi dei dispositivi, uno per peer
WG_PEERS=telefono,portatile
# Split tunnel: la VPN instrada solo la rete VPN e la LAN di casa. Per tutto il traffico: 0.0.0.0/0
# Cambia 192.168.1.0/24 con la subnet reale della tua LAN (ip route | grep src)
WG_ALLOWEDIPS=10.13.13.0/24,192.168.1.0/24
# true = il pannello puo' mostrare QR code e .conf dei peer (contengono chiavi PRIVATE). Tienilo false a regime.
WG_EXPOSE_PEERS=false

# ---------- SteamCMD ----------
STEAMCMD_IMAGE=steamcmd/steamcmd:latest
